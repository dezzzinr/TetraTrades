# Copy to .env for local development. Replace with the pooled PostgreSQL
# connection string shown under Connect in your Neon dashboard.
# Never commit your real connection string to Git.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-HOST-pooler.neon.tech/DBNAME?sslmode=require"

# If DATABASE_URL above is a POOLED connection string (hostname contains
# "-pooler" on Neon, or you're using Supabase's transaction pooler on port
# 6543), uncomment this and set it to the DIRECT/unpooled connection string
# instead. "npx drizzle-kit push"/"generate" need a direct connection -
# running them against a pooled one typically just hangs forever on
# "Pulling schema from database...". The app itself keeps using the pooled
# DATABASE_URL above; only schema pushes/migrations use this one.
#   Neon: Connection Details -> toggle "Pooled connection" OFF -> copy that.
#   Supabase: use the "Session" string (port 5432), not "Transaction" (6543).
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@YOUR-HOST.neon.tech/DBNAME?sslmode=require"

# Recommended for reliable live quotes. Create a free Demo key in CoinGecko's
# Developer Dashboard. This key is read only on the server; never use NEXT_PUBLIC_.
COINGECKO_API_KEY="CG-nALWQ6RSGojm9Zm9Mt7faMFc"

# If you have a paid Pro key, use COINGECKO_PRO_API_KEY instead. The app will
# automatically use the Pro API host when this variable is set.

# Comma-separated list of emails that should be granted admin access (the
# deposit-review panel at /admin). Registering or logging in with a matching
# email promotes that account to admin automatically.
ADMIN_EMAILS="you@example.com"

# Optional: enables real outbound email for the notification system (account
# created, login, trades, deposits/withdrawals, subscriptions, admin actions,
# etc). Get a free key at https://resend.com/api-keys. Without this set,
# emails are "stubbed" - just logged to the server console - while in-app
# notifications (the bell icon) keep working normally either way.
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optional: the "from" address used for notification emails. On Resend's
# free tier (no verified domain), this MUST stay onboarding@resend.dev, and
# you can only receive mail at the address you signed up to Resend with -
# verify your own domain in Resend to send to any address.
# EMAIL_FROM="NexaTrade <onboarding@resend.dev>"

# Optional: your deployed app's URL, used only to build the "Open NexaTrade"
# button in notification emails. Falls back to Vercel's auto-set VERCEL_URL
# when deployed there, otherwise the button is simply omitted.
# APP_URL="https://your-deployment.vercel.app"

# Optional: enables the Smartsupp live-chat widget (a floating chat bubble
# shown on every page, site-wide). Get your key from the Smartsupp
# dashboard: Settings -> Chatbox -> Installation - it's the "key" value in
# the embed snippet shown there (a ~24-character hex string). Must be
# prefixed with NEXT_PUBLIC_ (it's sent to the browser) and the dev server
# must be restarted after setting it. Without this set, no chat widget is
# loaded at all.
# NEXT_PUBLIC_SMARTSUPP_KEY="your-smartsupp-key-here"
